{
  "name": "rolodex",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "description": "Open-source relationship rolodex as an MCP tool: own your contacts (SQLite), sync with Google Contacts, and give your AI agents a rolodex they can read, search, and update. Configured per-install; add it as a tool and it's yours.",
  "type": "module",
  "bin": { "rolodex-mcp": "dist/mcp/server.js" },
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "NODE_OPTIONS=--experimental-sqlite tsx src/mcp/server.ts",
    "shell": "NODE_OPTIONS=--experimental-sqlite tsx src/shell/server.ts",
    "shell:build": "tsc -p tsconfig.json && cp src/shell/index.html dist/shell/index.html",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS=--experimental-sqlite vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "tsx": "^4.19.0",
    "vitest": "^3.2.4"
  }
}
